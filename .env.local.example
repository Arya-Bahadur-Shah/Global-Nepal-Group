# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# --- Admin panel (/admin) ---
# Single admin user; no signup flow. Generate the hash with:
#   node scripts/hash-password.js <your-password>
# (the script already escapes the $ characters for you — paste its output as-is;
# Next.js expands unescaped $ in .env files and would otherwise mangle the hash)
ADMIN_EMAIL=admin@globalnepalgroup.com
ADMIN_PASSWORD_HASH=
# Any long random string — used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Canonical site URL (SEO + social cards) ---
# The public origin, no trailing slash. Used by app/sitemap.js,
# app/robots.js and the metadataBase in app/layout.jsx that turns the
# Open Graph image path into the absolute URL link scrapers require.
#
# Leave it blank on Vercel and it falls back to the project's production
# hostname, which is correct but ugly (…vercel.app). Set it to the real
# domain once that is live, or every shared link and every sitemap entry
# advertises the Vercel one. Locally, blank means http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Extra image hosts (optional) ---
# next/image only fetches from hosts allowlisted in next.config.mjs.
# That list covers Vercel Blob (all admin uploads) plus the manufacturer
# and stock-photo domains already in use. If an editor pastes an image
# URL from a NEW host, add it here — comma-separated, wildcards allowed
# — and redeploy, instead of editing code:
#   EXTRA_IMAGE_HOSTS=cdn.example.com,*.partner-cdn.net
# The symptom of a missing host is a broken image, not a silent one.
EXTRA_IMAGE_HOSTS=

# --- Ticketing system (/support) ---
# The separately-hosted Soori ticketing app (Django REST + React). Set this
# per Vercel environment: Production -> the live instance, Preview -> a
# staging instance, so PR previews never touch real customer tickets.
# The origin of this URL is also the ONLY origin /support will accept
# postMessage from, so it must match exactly (scheme + host + port).
NEXT_PUBLIC_TICKETING_APP_URL=http://localhost:5173
# Only needed if this app ever calls the ticketing API directly
# (server-side). The iframe itself does not use this.
NEXT_PUBLIC_TICKETING_API_URL=http://127.0.0.1:8000/api

# --- File uploads (images, videos, brochures) ---
# Create a Blob store at vercel.com -> project -> Storage; it gives you
# this token. REQUIRED in production: Vercel's filesystem is read-only,
# so without it the admin panel cannot accept a file at all.
#
# Unset locally, uploads fall back to writing into public/uploads/,
# which keeps `npm run dev` working with no cloud setup. Be aware a file
# saved that way is LOCAL ONLY — public/uploads/ is gitignored, so it
# never reaches a deployment. Set the token (production's is fine) when
# adding content that needs to ship.
BLOB_READ_WRITE_TOKEN=

# --- Database ---
# Postgres. Locally, after creating the database:
#   DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/gng_db
# Avoid @ : / # ? in the password, or percent-encode them — they end
# parts of a URL and silently truncate the credentials.
DATABASE_URL=

# ================================================================
# EMAIL
#
# Used for admin sign-in codes and lead notifications. The provider is
# chosen automatically: Gmail if set, else Resend, else the message is
# printed to the server console.
#
# With NEITHER configured, sign-in still works — the code appears in the
# terminal running the server. That's fine locally and a problem in
# production, where it would land in the host's logs and effectively
# lock you out. Configure one before deploying.
# ================================================================

# --- Option A: Gmail SMTP (sends to any address, no DNS setup) ---
#
# GMAIL_APP_PASSWORD must be an App Password, NOT your normal Gmail
# password — Google blocked regular-password SMTP in 2022. App
# Passwords only exist once 2-Step Verification is on:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# Google displays it with spaces; paste it here WITHOUT them.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Option B: Resend (better deliverability, needs a verified domain) ---
# Until globalnepalgroup.com is verified at resend.com, the shared
# sender only delivers to the address that owns the Resend account —
# so it cannot email arbitrary recipients. Gmail has no such limit.
RESEND_API_KEY=

# Sender shown on outgoing mail. Defaults to your Gmail address.
# MAIL_FROM=Global Nepal Group <noreply@globalnepalgroup.com>

# Where contact-form leads are emailed. Leads are saved to /admin/leads
# either way.
LEADS_TO_EMAIL=
