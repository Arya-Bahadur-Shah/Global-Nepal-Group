# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# --- Admin panel (/admin) ---
# Single admin user; no signup flow. Generate the hash with:
#   node scripts/hash-password.js <your-password>
# (the script already escapes the $ characters for you — paste its output as-is;
# Next.js expands unescaped $ in .env files and would otherwise mangle the hash)
ADMIN_EMAIL=admin@globalnepalgroup.com
ADMIN_PASSWORD_HASH=
# Any long random string — used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Ticketing system (/support) ---
# The separately-hosted Soori ticketing app (Django REST + React). Set this
# per Vercel environment: Production -> the live instance, Preview -> a
# staging instance, so PR previews never touch real customer tickets.
# The origin of this URL is also the ONLY origin /support will accept
# postMessage from, so it must match exactly (scheme + host + port).
NEXT_PUBLIC_TICKETING_APP_URL=http://localhost:5173
# Only needed if this app ever calls the ticketing API directly
# (server-side). The iframe itself does not use this.
NEXT_PUBLIC_TICKETING_API_URL=http://127.0.0.1:8000/api

# --- Lead notification emails (contact form + demo requests) ---
# Optional: without these, leads are still saved and visible in /admin/leads,
# just no email is sent. Get a key at https://resend.com.
RESEND_API_KEY=
LEADS_TO_EMAIL=
